# ==============================================================================
# SISTEM KEUANGAN KAS BERBASIS WEB DENGAN AI - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Settings
APP_NAME="Sistem Keuangan Kas Berbasis Web dengan AI"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/Project%20RPL/Sistem%20Kas/public
APP_TIMEZONE=Asia/Jakarta
APP_KEY=sistem_kas_ai_key_secret_2026_super_secure

# Database Connection (MySQL / MariaDB)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sistem_kas_ai
DB_USERNAME=root
DB_PASSWORD=

# Session Settings
SESSION_LIFETIME=7200
SESSION_SECURE_COOKIE=false

# AI Integration (Node.js Backend & Providers)
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
AI_SERVICE_ENABLED=true
AI_SERVICE_URL=http://127.0.0.1:5000/api/chat
AI_SERVICE_SECRET=sistem_kas_ai_node_secret_key_2026_auth
AI_SERVICE_TIMEOUT=12

# WhatsApp Notification (Fonnte Official API)
FONNTE_API_TOKEN=
FONNTE_API_URL=https://api.fonnte.com/send
FONNTE_COUNTRY_CODE=62
FONNTE_TIMEOUT=15

